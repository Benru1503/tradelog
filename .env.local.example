# Supabase — get these from your Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database — Settings → Database → Connection string
# Use the "Pooled connection" (port 6543) for DATABASE_URL
# Use the "Direct connection" (port 5432) for DIRECT_URL (used by Prisma migrate)
DATABASE_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# E2E tests — any random string. Used by /api/test/login (gated to non-prod).
TEST_AUTH_SECRET="generate-any-random-string-here"

# Sentry (PLANNED — not yet integrated; leave empty) — Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
# Sentry CI source-map upload — Settings → Account → API → Auth Tokens
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Market data — server-side only.
# Finnhub powers stock + forex search and quotes (free tier, 60 calls/min).
# Get a key at https://finnhub.io/dashboard. Without it, every stock/forex
# surface degrades to "—".
FINNHUB_API_KEY=""
# CoinGecko powers crypto search and quotes. Free tier needs no key.
# A demo key (https://www.coingecko.com/en/api) lifts the limit to ~50 calls/min.
COINGECKO_DEMO_API_KEY=""

# Gemini powers the /coach trade-journal review. Server-side only.
# Free key from https://aistudio.google.com/apikey (AI Studio, NOT Vertex AI —
# Vertex requires GCP billing). Without it /coach renders a setup notice.
# NOTE: on Google's free tier, submitted content may be used to improve their
# products. See docs/coach.md before pointing it at real trade data.
GEMINI_API_KEY=""
# Optional — override the model. Defaults to gemini-flash-latest (Google's
# alias for their current recommended Flash model — avoid pinning a specific
# snapshot like "gemini-2.5-flash", Google deprecates those for new accounts).
GEMINI_MODEL=""
