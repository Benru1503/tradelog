{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/snapshot-session.sh\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Snapshotting session state into CLAUDE.md"
          }
        ]
      }
    ]
  }
}
