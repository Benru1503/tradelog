// TradeLog database schema
// See files/PROJECT_SPEC.md for the full data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AssetType {
  STOCK
  CRYPTO
  FOREX
}

enum Direction {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
}

model User {
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trades Trade[]
  tags   Tag[]

  @@map("users")
}

model Trade {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  asset       String
  assetType   AssetType
  direction   Direction
  entryPrice  Decimal     @db.Decimal(20, 8)
  exitPrice   Decimal?    @db.Decimal(20, 8)
  quantity    Decimal     @db.Decimal(20, 8)
  entryDate   DateTime
  exitDate    DateTime?
  status      TradeStatus @default(OPEN)
  pnl         Decimal?    @db.Decimal(20, 8)
  pnlPercent  Decimal?    @db.Decimal(10, 4)
  fees        Decimal     @default(0) @db.Decimal(20, 8)
  notes       String?
  isShared    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags   TradeTag[]
  images TradeImage[]

  @@index([userId, entryDate])
  @@index([userId, status])
  @@index([isShared, createdAt])
  @@map("trades")
}

model Tag {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name   String
  color  String

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades TradeTag[]

  @@unique([userId, name])
  @@map("tags")
}

model TradeTag {
  tradeId String @db.Uuid
  tagId   String @db.Uuid

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@map("trade_tags")
}

model TradeImage {
  id        String   @id @default(uuid()) @db.Uuid
  tradeId   String   @db.Uuid
  url       String
  caption   String?
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("trade_images")
}
